#!/usr/bin/env bash
# ACES post-update hook: after an Omarchy update, re-link the ACES hooks, skills and plugin for this user and refresh
# the manifest. Idempotent.
(
  if command -v aces-omarchy-setup >/dev/null 2>&1; then aces-omarchy-setup >/dev/null 2>&1 || true; fi
  if command -v aces >/dev/null 2>&1; then aces fabric refresh >/dev/null 2>&1 || true; fi
) &
