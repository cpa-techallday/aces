# Maintainer: Carbon Project Australia
# Meta-package: everything an ACES OS desktop installs. Members that are not packaged yet are listed as optional
# so the meta-package resolves honestly; they move into depends as they land.
pkgname=aces-os
pkgver=0.1.0
pkgrel=6
pkgdesc="ACES OS: the ACES computational-engineering platform on Omarchy (meta-package)"
arch=('any')
url="file:///usr/share/doc/aces-os"
license=('MIT')
# calculix-ccx-bin (0.1.0-5): CalculiX ccx for the conforming tet10 second discretisation of aces golden on the desktop
# aces-cad (0.1.0-6): local text-to-CAD, the sovereign CAD path
depends=('aces-base' 'aces-creative' 'aces-field' 'aces-consoles' 'aces-omarchy' 'aces-survey' 'aces-engineering' 'aces-voxel'
         'calculix-ccx-bin' 'aces-cad')
optdepends=('aces-studio: ACES Video Studio client and LoRA registry (not packaged yet; the rig video lane is not deployed)'
            'omarchy: the desktop this is designed for; the engine also runs without it'
            'aces-cad-onshape: Onshape FeatureScript adapter (cloud)')

package() {
  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  printf '%s\n' "ACES OS $pkgver" "Members: ${depends[*]}" "Pending: aces-studio" \
    "Policy mode and project classes: /etc/aces (aces policy show)" > "$pkgdir/usr/share/doc/$pkgname/README"
}
