# Maintainer: Carbon Project Australia
# The aces command line and the /etc/aces defaults. Sources are packed from src/aces-base by bin/build.
pkgname=aces-base
pkgver=0.1.0
pkgrel=4
# 0.1.0-4: a documented [console] table in /etc/aces/aces.toml and DEFAULTS (bind, port, static_dir, state_dir) for
# aces-console, which reads it through aces.config.load(); the console itself needs only >=0.1.0-3 (a missing table
# falls back to the same values inside the console package)
pkgdesc="ACES OS base: the aces CLI (fabric manifest, policy and ledger with ledger record, projects, doctor, lane tests, the aces golden passthrough) and /etc/aces defaults"
arch=('any')
url="file:///usr/share/doc/aces-base"
license=('MIT')
depends=('python>=3.11')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
backup=('etc/aces/aces.toml' 'etc/aces/policy.json' 'etc/aces/modes.json')
source=("$pkgname-src.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname"
  # the CLI must import and the ledger must round-trip without touching the real home directory
  local e=(PYTHONPATH="$srcdir/$pkgname" ACES_ETC="$srcdir/$pkgname/etc" ACES_USER_CONFIG="$srcdir/t/cfg"
           ACES_STATE="$srcdir/t/state" ACES_WORK="$srcdir/t/work")
  rm -rf "$srcdir/t"; mkdir -p "$srcdir/t"
  env "${e[@]}" python - <<'EOF'
import os
from aces import cli, ledger, policy, project
assert cli.main(["policy", "show"]) == 0
assert cli.main(["project", "new", "check-project"]) == 0
assert cli.main(["project", "add-component", "check-project", "example-component"]) == 0
assert cli.main(["project", "classify", "check-project", "commercial", "--reason", "packaging check"]) == 0
assert cli.main(["policy", "override", "example-component", "--reason", "packaging check"]) == 0
ok, n, msg = ledger.verify()
assert ok and n == 3, (ok, n, msg)
assert cli.main(["doctor", "--offline"]) == 0
print("aces self-check passed:", n, "ledger entries")
EOF
  # unit tests: ledger.record and its checks, the CLI, two concurrent writers, the golden passthrough (their own
  # temporary state; the 3-entry ledger above is not touched)
  env "${e[@]}" python -m unittest discover -s tests
  # 0.1.0-3 in the same environment: ledger record, refused kinds, verify, add-evidence, show --json, aces golden
  env "${e[@]}" python - "$srcdir/t" <<'EOF'
import contextlib, io, json, os, sys, tempfile
from aces import cli, ledger, project
t = sys.argv[1]
payload = os.path.join(t, "golden-payload.json")
with open(payload, "w", encoding="utf-8") as fh:
    json.dump({"project": "check-project", "run_id": "check", "verdict": "PASS"}, fh)
out = io.StringIO()
with contextlib.redirect_stdout(out):
    assert cli.main(["ledger", "record", "golden.run", "--json", payload, "--print", "json"]) == 0
rec = json.loads(out.getvalue())
assert rec["n"] == 4 and rec["kind"] == "golden.run" and rec["recorded"] is True, rec
assert cli.main(["ledger", "record", "policy.override", "--json", payload]) == 2
assert cli.main(["ledger", "record", "Bad Kind", "--json", payload]) == 2
ok, n, msg = ledger.verify()
assert ok and n == 4, (ok, n, msg)
assert cli.main(["project", "add-evidence", "check-project", "golden/check"]) == 0
assert "golden/check" in project.show("check-project")["evidence"]
out = io.StringIO()
with contextlib.redirect_stdout(out):
    assert cli.main(["ledger", "show", "--json", "-n", "1"]) == 0
shown = json.loads(out.getvalue())
assert len(shown) == 1 and shown[0]["n"] == 4, shown
os.environ.pop("ACES_GOLDEN_CMD", None)
saved_path = os.environ.get("PATH", "")
os.environ["PATH"] = tempfile.mkdtemp(prefix="empty-path-")
assert cli.main(["golden", "run", "--demo"]) == 127
os.environ["PATH"] = saved_path
os.environ["ACES_GOLDEN_CMD"] = json.dumps([sys.executable, "-c", "import sys; sys.exit(len(sys.argv))"])
assert cli.main(["golden", "a", "b"]) == 3
print("aces 0.1.0-3 checks passed:", n, "ledger entries, golden passthrough 127 and 3")
EOF
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 etc/aces.toml "$pkgdir/etc/aces/aces.toml"
  install -Dm644 etc/policy.json "$pkgdir/etc/aces/policy.json"
  install -Dm644 etc/modes.json "$pkgdir/etc/aces/modes.json"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
