# Maintainer: Carbon Project Australia
# Omarchy coupling for ACES, overlay not fork: hooks for the post-boot and post-update events, the aces-engineering
# agent skill, the aces-fabric shell plugin, and the per-user setup script that links them under ~/.config and the
# agents' skill directories. Everything the package owns lives under /usr/share/aces/omarchy.
pkgname=aces-omarchy
pkgver=0.1.0
pkgrel=2
pkgdesc="ACES on Omarchy: hooks, agent skill, aces-fabric shell plugin and the per-user aces-omarchy-setup"
arch=('any')
url="file:///usr/share/doc/aces-omarchy"
license=('MIT')
depends=('aces-base')
optdepends=('omarchy: the desktop these hooks and the plugin are for; without it only the skill links are useful'
            'aces-creative: the post-boot hook labels its launcher entries'
            'aces-consoles: console launcher entries')
install=aces-omarchy.install
source=("$pkgname-src.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 aces-omarchy-setup "$pkgdir/usr/bin/aces-omarchy-setup"
  for h in hooks/*.d/*; do
    install -Dm755 "$h" "$pkgdir/usr/share/aces/omarchy/$h"
  done
  find skills plugins -type f 2>/dev/null | while read -r f; do
    install -Dm644 "$f" "$pkgdir/usr/share/aces/omarchy/$f"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
