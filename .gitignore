# build outputs of bin/build (the local [aces] repo, pacman and source caches, logs)
repo/
cache/
logs/
# source tarballs are packed from src/<pkg>/ on every build
pkgbuilds/*/*-src.tar.gz
# makepkg leftovers if a PKGBUILD is ever built outside the container
pkgbuilds/*/src/
pkgbuilds/*/pkg/
pkgbuilds/*/*.pkg.tar.zst
__pycache__/
*.pyc
# package signing: the public key is committed, the secret key and the GnuPG home never are
keys/gnupg/
keys/*.sec.asc
keys/gen.params
# Omarchy rehearsal VM downloads
rehearsal/iso/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run outputs, geometry and evidence live outside git (rig NVMe / workstation).
out/
runs/
*.stl
!examples/**/*.stl
*.step
*.vtk
*.vtu
*.npz
*.h5
optuna.db

# formgen run outputs and machine-specific add-in config
out_*/
formgen-out/
*.JBI
*.glb
fusion_addin/Formgen/formgen_path.txt
_import_*/
!studies/*/cad/*.stl
!studies/*/cad/*.step
.coverage
