#!/usr/bin/env bash
# Build one or more ACES packages inside the Arch builder container and add them to the local [aces] repo.
#
#   bin/build                 build every package under pkgbuilds/
#   bin/build aces-base       build one
#   bin/build --nodeps pkg    skip dependency checks (meta-packages whose deps are not built yet)
#
# Works from Git Bash on Windows (Docker Desktop) and from Linux. Sources for packages that have a matching
# src/<name>/ directory are tarred into the package directory as <name>-src.tar.gz before the build, so the
# PKGBUILD can declare source=("$pkgname-src.tar.gz").
#
# Signing: when keys/aces-pkgs.sec.asc and keys/FINGERPRINT exist (the secret key is never committed; CI writes it
# from the ACES_SIGNING_KEY secret), every package and the repo database are signed (makepkg --sign, repo-add --sign).
# keys/aces-pkgs.pub.asc is the matching public key that installers trust.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="aces-builder:latest"
NODEPS=""
PKGS=()
declare -A PKG_NODEPS=()
for a in "$@"; do
  case "$a" in
    --nodeps) NODEPS="--nodeps" ;;
    *) PKGS+=("$a") ;;
  esac
done
if [ ${#PKGS[@]} -eq 0 ]; then
  # pkgbuilds/ORDER: members before dependants; "<pkg> nodeps" marks meta-packages built with --nodeps
  if [ -f "$ROOT/pkgbuilds/ORDER" ]; then
    while IFS= read -r name flag _; do
      case "$name" in ""|\#*) continue ;; esac
      if [ -d "$ROOT/pkgbuilds/$name" ]; then
        PKGS+=("$name")
        if [ "${flag:-}" = "nodeps" ]; then PKG_NODEPS["$name"]=1; fi
      else
        echo "!! ORDER names $name but pkgbuilds/$name does not exist"
      fi
    done < "$ROOT/pkgbuilds/ORDER"
  fi
  while IFS= read -r d; do
    n="$(basename "$d")"
    listed=0
    for q in "${PKGS[@]}"; do if [ "$q" = "$n" ]; then listed=1; break; fi; done
    if [ "$listed" = 0 ]; then echo "!! $n is not in pkgbuilds/ORDER; building it last"; PKGS+=("$n"); fi
  done < <(find "$ROOT/pkgbuilds" -mindepth 1 -maxdepth 1 -type d | sort)
fi

hostpath() {  # docker needs a Windows path from Git Bash; MSYS_NO_PATHCONV keeps docker's own args intact
  if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "== building builder image"
  docker build -t "$IMAGE" -f "$ROOT/docker/builder.Dockerfile" "$ROOT/docker"
fi
mkdir -p "$ROOT/repo/x86_64" "$ROOT/cache/pacman" "$ROOT/cache/sources" "$ROOT/logs" "$ROOT/keys"

SIGN=0
if [ -f "$ROOT/keys/aces-pkgs.sec.asc" ] && [ -f "$ROOT/keys/FINGERPRINT" ]; then
  SIGN=1
  echo "== signing packages and the repo database with key $(cat "$ROOT/keys/FINGERPRINT")"
else
  echo "== no signing key (keys/aces-pkgs.sec.asc): packages are built unsigned"
fi

status=0
for p in "${PKGS[@]}"; do
  dir="$ROOT/pkgbuilds/$p"
  if [ ! -f "$dir/PKGBUILD" ]; then echo "!! no PKGBUILD in $dir"; status=1; continue; fi
  if [ -d "$ROOT/src/$p" ]; then
    echo "== packing sources for $p"
    tar -C "$ROOT/src" -czf "$dir/$p-src.tar.gz" "$p"
  fi
  pkg_nodeps="$NODEPS"
  if [ -n "${PKG_NODEPS[$p]:-}" ]; then pkg_nodeps="--nodeps"; fi
  echo "== building $p${pkg_nodeps:+ ($pkg_nodeps)}"
  log="$ROOT/logs/$p.log"
  if MSYS_NO_PATHCONV=1 docker run --rm \
      -v "$(hostpath "$dir"):/build/pkg:ro" \
      -v "$(hostpath "$ROOT/repo"):/repo" \
      -v "$(hostpath "$ROOT/cache/pacman"):/var/cache/pacman/pkg" \
      -v "$(hostpath "$ROOT/cache/sources"):/srcdest" \
      -v "$(hostpath "$ROOT/keys"):/keys:ro" \
      -e NODEPS="$pkg_nodeps" -e SIGN="$SIGN" \
      "$IMAGE" bash -lc '
        set -euo pipefail
        sudo chown -R builder /repo /srcdest /var/cache/pacman/pkg
        rm -rf /build/work && cp -r /build/pkg /build/work && cd /build/work
        SIGNARGS=(); REPOSIGN=()
        if [ "$SIGN" = 1 ]; then
          export GNUPGHOME=/tmp/gnupg
          mkdir -p -m 700 "$GNUPGHOME"
          gpg --batch --quiet --import /keys/aces-pkgs.sec.asc
          KEY="$(cat /keys/FINGERPRINT)"
          SIGNARGS=(--sign --key "$KEY")
          REPOSIGN=(--sign --key "$KEY")
        fi
        if [ ! -f /repo/x86_64/aces.db.tar.zst ]; then repo-add "${REPOSIGN[@]}" /repo/x86_64/aces.db.tar.zst >/dev/null; fi
        sudo pacman -Sy --noconfirm >/dev/null
        SRCDEST=/srcdest PKGDEST=/repo/x86_64 makepkg -sfC --noconfirm --skippgpcheck $NODEPS "${SIGNARGS[@]}"
        cd /repo/x86_64 && repo-add -R "${REPOSIGN[@]}" aces.db.tar.zst "$(ls -t ./*.pkg.tar.zst | head -1)" >/dev/null
        namcap /build/work/PKGBUILD || true
        newest="$(ls -t /repo/x86_64/*.pkg.tar.zst | head -1)"
        if [ "$SIGN" = 1 ]; then
          gpg --batch --verify "$newest.sig" "$newest" 2>/dev/null && echo "== signature verified: $(basename "$newest").sig"
        fi
        echo "== built: $newest"
      ' > "$log" 2>&1; then
    tail -n 3 "$log"
  else
    echo "!! $p failed; see logs/$p.log"; tail -n 25 "$log"; status=1
  fi
done
exit $status
