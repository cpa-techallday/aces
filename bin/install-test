#!/usr/bin/env bash
# Install-test the built packages in a clean Arch container: enable the [aces] repo, install the named packages,
# exercise the CLI, and dry-run dependency resolution for the big meta-packages (no multi-GB downloads).
# Usage: bin/install-test [pkg ...]   (default: aces-base aces-creative aces-consoles aces-console aces-omarchy aces-cad-onshape)
#
# aces-console (2026-10-11) replaces aces-consoles: when both are named, aces-consoles is installed first and the
# aces-console block exercises the replacement through pacman -Su, then runs the package's install check (spec 7.2)
# with a random GRID CONTROL token that must appear in no output and no log, and the installed unit tests.
#
# Signed repo: when keys/aces-pkgs.pub.asc exists and the repo database carries a signature, the container trusts
# that key through pacman-key and installs with SigLevel = Required DatabaseRequired, which is exactly what a
# customer machine will do. Otherwise it falls back to SigLevel = Optional TrustAll and says so.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
hostpath() { if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
repo="$(hostpath "$here/repo")"
keys="$(hostpath "$here/keys")"
pkgs="${*:-aces-base aces-creative aces-consoles aces-console aces-omarchy aces-cad-onshape}"
sigmode="Optional TrustAll"
if [ -f "$here/keys/aces-pkgs.pub.asc" ] && [ -f "$here/keys/FINGERPRINT" ] && [ -f "$here/repo/x86_64/aces.db.tar.zst.sig" ]; then
  sigmode="Required DatabaseRequired"
fi
mkdir -p "$here/keys"
# the golden path copies its report, result and winner renders to logs/golden/ (CI uploads logs/)
mkdir -p "$here/logs"
export MSYS_NO_PATHCONV=1
docker run --rm -v "$repo:/repo:ro" -v "$keys:/keys:ro" -v "$(hostpath "$here/logs"):/logs" -e PKGS="$pkgs" -e SIGMODE="$sigmode" archlinux:base bash -euo pipefail -c '
if [ "$SIGMODE" != "Optional TrustAll" ]; then
  pacman-key --init >/dev/null 2>&1
  pacman-key --add /keys/aces-pkgs.pub.asc >/dev/null 2>&1
  pacman-key --lsign-key "$(cat /keys/FINGERPRINT)" >/dev/null 2>&1
  echo "== signed repo: key $(cat /keys/FINGERPRINT) trusted; SigLevel = $SIGMODE"
else
  echo "== unsigned repo (no key or no database signature); SigLevel = $SIGMODE"
fi
printf "\n[aces]\nSigLevel = %s\nServer = file:///repo/x86_64\n" "$SIGMODE" >> /etc/pacman.conf
pacman -Sy --noconfirm >/dev/null
echo "== [aces] repo contents"; pacman -Sl aces
# aces-console replaces aces-consoles: when both are named, aces-consoles is installed here and the replacement is
# exercised through pacman -Su in the aces-console block below
install_pkgs="$PKGS"; replace_consoles=0
if [[ " $PKGS " == *" aces-consoles "* && " $PKGS " == *" aces-console "* ]]; then
  replace_consoles=1
  install_pkgs="$(printf "%s\n" $PKGS | grep -v -x "aces-console" | tr "\n" " ")"
fi
echo "== install: $install_pkgs"
pacman -S --noconfirm $install_pkgs >/dev/null
echo "== aces --version"; aces --version
echo "== aces doctor --offline"; aces doctor --offline || true
echo "== aces policy show"; aces policy show
echo "== project + ledger"
aces project new demo --hypothesis "install test"
aces project add-component demo fluidx3d
aces project classify demo commercial --reason "install test end-use gate"
aces policy override fluidx3d --reason "install test"
aces ledger verify
aces ledger show
echo "== fabric (the server is not reachable from this container; the manifest must say so, not invent lanes)"
aces fabric refresh || true
aces lane list || true
if command -v aces-creative-labels >/dev/null 2>&1; then
  echo "== creative labels"; aces-creative-labels; ls /root/.local/share/applications 2>/dev/null || true
  echo "== desktop entries"; ls /usr/share/applications | grep -i -E "aces|craft" || true
else
  echo "== creative labels: aces-creative not in this run"
fi
if command -v aces-omarchy-setup >/dev/null 2>&1; then
  echo "== omarchy setup (no Omarchy in the container: hooks, skill links and the plugin copy only)"
  mkdir -p /root/.claude /root/.agents
  aces-omarchy-setup || true
  ls -la /root/.config/omarchy/hooks/*.d /root/.claude/skills /root/.agents/skills 2>/dev/null || true
  ls -la /root/.config/omarchy/plugins/aces-fabric 2>/dev/null | head -6 || true
  aces doctor --offline | grep -E "^(skills|omarchy)" || true
  aces-omarchy-setup --remove || true
else
  echo "== omarchy setup: aces-omarchy not in this run"
fi
if pacman -Si aces-survey >/dev/null 2>&1 && [[ " $PKGS " == *" aces-survey "* || " $PKGS " == *" aces-creative "* ]]; then
  echo "== survey (no docker or QGIS in the container: install without deps, setup, help, status)"
  pacman -Sdd --noconfirm aces-survey >/dev/null
  ls /usr/share/aces-survey; cat /usr/share/aces-survey/WEBODM_VERSION; ls /usr/share/aces-survey/webodm | head -5
  aces-survey-setup || true
  ls /root/.local/share/QGIS/QGIS3/profiles/default/python/plugins/FlyPath | head -3; cat /root/.local/share/QGIS/QGIS3/profiles/default/QGIS3.ini
  ls /root/.local/share/aces/webodm | head -3
  aces-webodm --help | head -3
  aces-webodm status || true
  aces-survey-setup --remove || true
  cat /usr/share/licenses/aces-survey/LICENSES.md | head -5
  pacman -Rdd --noconfirm aces-survey >/dev/null   # so the dry-runs below resolve aces-survey and its deps from scratch
else
  echo "== survey: not exercised in this run"
fi
if command -v aces-voxel >/dev/null 2>&1; then
  echo "== engineering and voxel (CPU paths in the venv)"
  aces-gendesign selftest 2>&1 | tail -3 || true
  aces-voxel fea --self-test 2>&1 | tail -3 || true
  ls -la /root/.claude/skills 2>/dev/null | grep -i voxel || true
fi
if pacman -Q aces-engineering >/dev/null 2>&1; then
  command -v aces-golden >/dev/null 2>&1 || { echo "golden: aces-engineering is installed but aces-golden is missing"; exit 1; }
  echo "== conforming check tools: gmsh in the venv (a hard check), ccx when calculix-ccx-bin is installed"
  /opt/aces/engineering/venv/bin/python -c "import importlib.metadata as m, gmsh; print(\"gmsh\", m.version(\"gmsh\"))"
  have_ccx=0; if pacman -Q calculix-ccx-bin >/dev/null 2>&1; then have_ccx=1; fi
  if command -v ccx >/dev/null 2>&1; then
    # ccx -v prints "This is Version 2.23" and exits 201
    echo "ccx: $(command -v ccx): $( (ccx -v 2>&1 || true) | grep -m1 -i "version" || echo "no version line")"
  else
    echo "ccx: not installed (the conforming check reports not run: ccx-not-found)"
  fi
  echo "== golden path: aces golden run --demo (computed organic part -> real voxel FEA -> sweep -> surrogate -> verify -> evidence -> report)"
  rm -rf /logs/golden
  aces golden compute
  echo "== aces golden compute --lane sim/pool: there is no rig from this container, so it must exit 2"
  rc=0; aces golden compute --lane sim/pool >/tmp/lane.out 2>&1 || rc=$?
  cat /tmp/lane.out
  if [ "$rc" -ne 2 ]; then echo "golden: compute --lane sim/pool exited $rc, expected 2"; exit 1; fi
  # argparse also exits 2: an aces golden without --lane on compute must not pass this check by accident
  if grep -q "unrecognized arguments" /tmp/lane.out; then echo "golden: this aces golden compute has no --lane (the 2 was a usage error)"; exit 1; fi
  t0=$(date +%s); rc=0
  aces golden run --demo --json --progress lines > /tmp/golden.json || rc=$?
  echo "golden: exit $rc after $(( $(date +%s) - t0 )) s"
  json_ok=1; python3 -c "import json; d=json.load(open(\"/tmp/golden.json\")); print(d.get(\"verdict_line\") or d.get(\"message\"))" || { echo "golden: stdout was not one JSON document"; json_ok=0; }
  run_dir="$(python3 -c "import json; print(json.load(open(\"/tmp/golden.json\")).get(\"run_dir\") or \"\")" 2>/dev/null || true)"
  [ -n "$run_dir" ] || run_dir="$(ls -td /root/Work/*/golden/*/ 2>/dev/null | head -n 1 || true)"
  aces golden show || true
  if [ -n "$run_dir" ] && [ -d "$run_dir" ]; then
    ls -la "$run_dir"; head -n 40 "$run_dir/report.md" || true
    mkdir -p /logs/golden
    cp /tmp/golden.json /logs/golden/stdout.json
    for f in report.md report.html report.json result.json run.json validation.json compute_used.json log.txt; do
      if [ -f "$run_dir/$f" ]; then cp "$run_dir/$f" /logs/golden/; fi
    done
    for d in winner candidate figures; do
      if [ -d "$run_dir/$d" ]; then cp -r "$run_dir/$d" /logs/golden/; fi
    done
    # the conforming record and the ccx output, when the check got that far
    for f in conforming.json ccx.log; do
      if [ -f "$run_dir/m001/$f" ]; then cp "$run_dir/m001/$f" /logs/golden/; fi
    done
    # the run writes its records 0600 and this container is root: without this the host user (the CI runner that
    # uploads logs/) cannot read them, and upload-artifact fails on logs/golden/compute_used.json with EACCES
    chmod -R a+rX /logs/golden
  fi
  if [ "$rc" -ne 0 ] || [ "$json_ok" -ne 1 ]; then echo "golden: FAILED (exit $rc, one JSON document: $json_ok)"; exit 1; fi
  # the conforming status is printed, never gated on ran (a 2-vCPU runner may hit the 900 s desktop timeout); with
  # calculix-ccx-bin installed, the tools themselves must have been found
  conf="$(python3 -c "import json; c=json.load(open(\"/tmp/golden.json\")).get(\"conforming\") or {}; print(c.get(\"status\") or \"none\", \"|\", c.get(\"reason\") or \"\")")"
  echo "golden: conforming status ${conf}"
  conf_status="${conf%% |*}"
  if [ "$have_ccx" -eq 1 ] && { [ "$conf_status" = "ccx-not-found" ] || [ "$conf_status" = "gmsh-not-found" ]; }; then
    echo "golden: calculix-ccx-bin is installed, but the conforming check says $conf_status"; exit 1
  fi
  aces golden verify latest
  aces ledger verify
  aces-evidence verify
else
  echo "== golden path: aces-engineering not in this run"
fi
if command -v aces-onshape >/dev/null 2>&1; then
  echo "== onshape adapter (no Onshape keys in the container: help, whoami must exit 3, unit tests against the fake server)"
  aces-onshape --help >/tmp/onshape-help
  head -5 /tmp/onshape-help
  rc=0; aces-onshape whoami >/tmp/onshape-out 2>&1 || rc=$?
  cat /tmp/onshape-out
  if [ "$rc" -ne 3 ]; then echo "aces-onshape whoami: expected exit 3 without credentials, got $rc"; exit 1; fi
  grep -q "no Onshape API keys" /tmp/onshape-out
  PYTHONDONTWRITEBYTECODE=1 NO_COLOR=1 python -m unittest discover -s /usr/share/aces/cad-onshape/tests
  ls /usr/share/aces/cad-onshape /usr/share/aces/cad-onshape/skills/aces-cad-onshape
else
  echo "== onshape adapter: aces-cad-onshape not in this run"
fi
if command -v aces-cad >/dev/null 2>&1; then
  echo "== local CAD (aces-cad): doctor, the ACES plate end to end in a sovereign project, hostile scripts, installed tests"
  rm -rf /logs/cad; mkdir -p /logs/cad
  rc=0; aces-cad doctor --json > /logs/cad/doctor.json || rc=$?
  cat /logs/cad/doctor.json
  if [ "$rc" -eq 3 ]; then
    echo "aces-cad: the strict sandbox (seccomp and Landlock) is not available in this container: this block runs with ACES_CAD_SANDBOX=permissive, so the kernel guards were NOT exercised here"
    export ACES_CAD_SANDBOX=permissive
  elif [ "$rc" -ne 0 ]; then echo "aces-cad doctor failed (exit $rc)"; exit 1; fi
  aces project new cadtest --class sovereign --hypothesis "aces-cad install test"
  aces-cad run /usr/share/aces/cad/tests/scripts/aces_plate.py --project cadtest --name plate --json > /logs/cad/run.json
  python3 -c "import json, math; p = json.load(open(\"/logs/cad/run.json\"))[\"result\"][\"parts\"][0]; e = 60*40*5 - math.pi*25*5; assert abs(p[\"volume_mm3\"] - e) < 1e-6 and p[\"valid\"], p; print(\"plate volume\", p[\"volume_mm3\"], \"expected\", e)"
  aces-cad inspect latest --project cadtest --check mass,validity,holes,thickness --material AlSi10Mg --json > /logs/cad/inspect.json
  aces-cad render latest --project cadtest --view iso,front --json > /logs/cad/render.json
  aces-cad drawing latest --project cadtest --json > /logs/cad/drawing.json
  aces-cad pull latest --project cadtest --json > /logs/cad/pull.json
  python3 /usr/share/aces/cad/tests/check_bundle.py /logs/cad/pull.json
  aces ledger show --kind cad.pull -n 1
  aces ledger verify
  aces project show cadtest
  rc=0; aces-cad run /usr/share/aces/cad/tests/scripts/hostile_socket.py --project cadtest --json > /logs/cad/hostile-socket.json || rc=$?
  if [ "$rc" -ne 5 ]; then echo "aces-cad: the socket script must be refused by the sandbox (exit 5), got $rc"; cat /logs/cad/hostile-socket.json; exit 1; fi
  rc=0; aces-cad run /usr/share/aces/cad/tests/scripts/hostile_loop.py --project cadtest --timeout 3 --json > /logs/cad/hostile-loop.json || rc=$?
  if [ "$rc" -ne 4 ]; then echo "aces-cad: the endless loop must time out (exit 4), got $rc"; cat /logs/cad/hostile-loop.json; exit 1; fi
  ACES_CAD_REQUIRE_WORKER=1 PYTHONPATH=/opt/aces/cad/lib PYTHONDONTWRITEBYTECODE=1 NO_COLOR=1 python -m unittest discover -s /usr/share/aces/cad/tests
  bundle="$(python3 -c "import json; print(json.load(open(\"/logs/cad/pull.json\"))[\"bundle\"])")"
  cp -r "$bundle" /logs/cad/bundle
  for f in /root/Work/cadtest/cad/local/runs/*/renders/*.png /root/Work/cadtest/cad/local/runs/*/drawings/*; do
    if [ -f "$f" ]; then cp "$f" /logs/cad/; fi
  done
  chmod -R a+rX /logs/cad
else
  echo "== local CAD: aces-cad not in this run"
fi
if [[ " $PKGS " == *" aces-console "* ]]; then
  echo "== aces-console: the one desktop console (replacement of aces-consoles, launcher entry, loopback server, install check, installed tests)"
  if [ "$replace_consoles" -eq 1 ]; then
    echo "== replacement: $(pacman -Q aces-consoles) is installed; pacman -Su must replace it with aces-console (replaces=aces-consoles)"
    pacman -Su --noconfirm >/dev/null || pacman -Su --ask=4 --noconfirm >/dev/null
    # by name: `pacman -Q aces-consoles` keeps answering after the replacement, through the provides= of aces-console
    if pacman -Qq | grep -q -x "aces-consoles"; then echo "aces-console: aces-consoles is still installed after pacman -Su"; exit 1; fi
    echo "replacement done: no package named aces-consoles is installed; pacman -Q aces-consoles now answers \"$(pacman -Q aces-consoles 2>/dev/null)\" through provides="
  fi
  pacman -Q aces-console
  pacman -Qi aces-console | grep -E "^(Name|Version|Provides|Replaces|Conflicts)"
  ls -la /usr/share/applications/aces.desktop /usr/share/aces/console/static/index.html /usr/share/aces/console/tests/install_check.py
  head -5 /usr/share/licenses/aces-console/LICENSES.md
  aces-console --version
  aces-console url
  aces-console status || true
  # the default set leaves 3 ledger entries (the project + ledger block above); the golden block adds its golden.run and
  # evidence entries (5 after it in every run so far), the CAD block its classify and cad.pull (7 after it; spec 7.2)
  EXPECT_LEDGER=3
  if pacman -Q aces-cad >/dev/null 2>&1; then EXPECT_LEDGER=">=7"; elif pacman -Q aces-engineering >/dev/null 2>&1; then EXPECT_LEDGER=">=5"; fi
  echo "== install check (spec 7.2): expected ledger entries ${EXPECT_LEDGER}; a random GRID CONTROL token is set and must appear in no output and no log"
  export ACES_GC_TOKEN="$(python3 -c "import secrets;print(secrets.token_hex(16))")"
  python3 -I /usr/share/aces/console/tests/install_check.py --port 8070 --expect-ledger "${EXPECT_LEDGER}" 2>&1 | tee /tmp/console-check.log
  test "${PIPESTATUS[0]}" -eq 0
  test -s /root/.local/state/aces/console/server.log
  # an explicit test rather than the negated grep of spec 7.2: under set -e a negated command never stops the script
  if grep -q -- "${ACES_GC_TOKEN}" /tmp/console-check.log /root/.local/state/aces/console/*.log; then echo "aces-console: the token value leaked into the check log or the server log"; exit 1; fi
  echo "token check: the token value is in neither /tmp/console-check.log nor /root/.local/state/aces/console/*.log"
  unset ACES_GC_TOKEN
  aces ledger verify
  echo "== installed tests of aces-console (fakes on 127.0.0.1 only; the browser harness prints SKIP without a browser)"
  PYTHONDONTWRITEBYTECODE=1 NO_COLOR=1 python -m unittest discover -s /usr/share/aces/console/tests -t /usr/share/aces/console
else
  echo "== aces-console: not in this run"
fi
echo "== dependency dry-run for the meta-packages (resolution only, nothing downloaded)"
for m in aces-field aces-survey aces-os; do
  if pacman -Sp "$m" >/tmp/out 2>/tmp/err; then echo "$m: resolves, $(wc -l </tmp/out) packages in the transaction"; else echo "$m: FAILS"; cat /tmp/err; fi
done
'
